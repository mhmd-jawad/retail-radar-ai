# Local Docker overrides this with its postgres container. On Lightsail,
# replace this value with the RDS URL and add sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_radar
DATABASE_TCP_TIMEOUT_SECONDS=10
DATABASE_CONNECT_RETRIES=3
DATABASE_CONNECT_RETRY_DELAY_SECONDS=1
RETAIL_AUTO_INIT_DB=true
RETAIL_TENANT_SLUG=default
RETAIL_STORE_CODE=MAIN

# Backend-owned recommendation sync. Enable scheduler in deployment to sync all SKUs daily at 7 AM Beirut time.
SYSTEM_DECISION_SCHEDULER_ENABLED=false
SYSTEM_DECISION_SCHEDULER_TIMEZONE=Asia/Beirut
SYSTEM_DECISION_SCHEDULER_HOUR=7
SYSTEM_DECISION_SCHEDULER_MINUTE=0
SYSTEM_DECISION_SYNC_BATCH_SIZE=25
SYSTEM_DECISION_SYNC_CONCURRENCY=1
SYSTEM_DECISION_STALE_RUN_MINUTES=10
SYSTEM_DECISION_LATEST_CACHE_SECONDS=5
REPORT_LIVE_CACHE_SECONDS=60
DATABASE_CONNECT_RETRIES=1
DATABASE_TCP_TIMEOUT_SECONDS=5
DATABASE_CONNECT_RETRY_DELAY_SECONDS=0
RETAIL_ENSURE_RUNTIME_SCHEMA=false
AUTH_ENSURE_RUNTIME_SCHEMA=false
SYSTEM_DECISION_IE1_BATCH_TIMEOUT_SECONDS=300
SYSTEM_DECISION_IE2_BATCH_TIMEOUT_SECONDS=180

# Auth/session settings. Set these in the real .env to create/update the admin account at EEP startup.
AUTH_TOKEN_SECRET=replace_with_a_long_random_auth_secret
AUTH_TOKEN_TTL_HOURS=12
RETAIL_ADMIN_EMAIL=admin@example.com
RETAIL_ADMIN_PASSWORD=replace_with_a_strong_password
RETAIL_ADMIN_NAME=Retail Radar Admin

# Create this in Apify: Account settings -> Integrations -> API tokens.
APIFY_TOKEN=replace_with_your_apify_token

# Any long random string. Add the same value to Apify webhook headers as x-webhook-secret.
APIFY_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Production HTTPS domain used by the AWS Caddy reverse proxy.
WEBHOOK_DOMAIN=webhook.example.com

# Local Grafana login for Docker Compose monitoring.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Required only for the standalone IE2 API when using --profile full.
IE2_API_KEY=replace_with_a_long_random_api_key

# Required by IE3 campaign generation or publishing when those actions are enabled.
OPENROUTER_API_KEY=
REPLICATE_API_KEY=
GEMINI_API_KEY=
IMGBB_API_KEY=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
META_APP_ID=
META_APP_SECRET=
